{
  "version": "2.0",
  "telemetryMode": "OpenTelemetry",
  "functionTimeout": "00:02:00",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    },
    "logLevel": {
      "default": "Information",
      "Function": "Information",
      "LaughingFish.SunriseSunsetApi": "Information",
      "Microsoft": "Warning",
      "Azure.Core": "Warning"
    }
  }
}
